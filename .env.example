# SmartCharge AI Environment Configuration Example

# Backend Application Settings
PROJECT_NAME="SmartCharge AI"
VERSION="1.0.0"

# JWT Authentication
SECRET_KEY="smartcharge-ai-super-secret-jwt-key-2025-secure-hash"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Default: local SQLite database seeded with 3,000 real Indian charging stations
DATABASE_URL="sqlite:///./smartcharge.db"

# External APIs
# Weather: Free Open-Meteo API is used out-of-the-box (no API key required)
# An optional key can be set here if using a paid tier or proxy
WEATHER_API_KEY=""
TRAFFIC_API_KEY=""

# Server Ports
BACKEND_HOST="127.0.0.1"
BACKEND_PORT=8000
FRONTEND_PORT=5173
